[global]
ioengine=libaio
direct=1
time_based
runtime=30s
group_reporting
size=1G
filename=/tmp/fio_testfile
numjobs=1
iodepth=4
bs=4k

[seq-write]
rw=write
bs=128k
stonewall

[seq-read]
rw=read
bs=128k
stonewall

[rand-read]
rw=randread
bs=64k
stonewall

[rand-write]
rw=randwrite
bs=32k
stonewall

[randrw-mix]
rw=randrw
rwmixread=70
bs=4k
stonewall
